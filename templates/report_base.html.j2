<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% block title %}V2A Inspect Experiment Report{% endblock %}</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f8f9fa; color: #212529; line-height: 1.5; padding: 20px; }
  .container { max-width: 1400px; margin: 0 auto; }
  h1 { font-size: 1.6rem; margin-bottom: 8px; }
  h2 { font-size: 1.3rem; margin: 24px 0 12px; border-bottom: 2px solid #dee2e6; padding-bottom: 6px; }
  h3 { font-size: 1.1rem; margin: 16px 0 8px; }
  .meta { color: #6c757d; font-size: 0.85rem; margin-bottom: 16px; }
  .meta span { margin-right: 16px; }

  /* Navigation */
  nav { background: #fff; border: 1px solid #dee2e6; border-radius: 8px; padding: 12px 16px; margin-bottom: 24px; }
  nav a { color: #0d6efd; text-decoration: none; margin-right: 16px; font-size: 0.9rem; }
  nav a:hover { text-decoration: underline; }
  nav a.active { font-weight: 700; color: #212529; }

  /* Cards */
  .card { background: #fff; border: 1px solid #dee2e6; border-radius: 8px; padding: 16px; margin-bottom: 16px; }
  .card-header { font-weight: 600; font-size: 1rem; margin-bottom: 8px; }

  /* Tables */
  table { width: 100%; border-collapse: collapse; font-size: 0.85rem; margin: 8px 0; }
  th, td { padding: 8px 10px; border: 1px solid #dee2e6; text-align: left; vertical-align: top; }
  th { background: #f1f3f5; font-weight: 600; white-space: nowrap; }
  .best { background: #d4edda; }
  .worst { background: #f8d7da; }

  /* Filmstrip */
  .filmstrip { display: flex; gap: 4px; overflow-x: auto; padding: 8px 0; }
  .filmstrip img { height: 80px; border-radius: 4px; flex-shrink: 0; }
  .filmstrip .frame-label { font-size: 0.7rem; color: #6c757d; text-align: center; }

  /* Scene comparison */
  .scene-block { margin: 12px 0; padding: 12px; background: #fff; border: 1px solid #dee2e6; border-radius: 6px; }
  .scene-header { font-weight: 600; color: #495057; margin-bottom: 8px; }
  .scene-row { display: grid; gap: 8px; margin-bottom: 8px; }
  .scene-cell { padding: 8px; background: #f8f9fa; border-radius: 4px; font-size: 0.83rem; }
  .scene-cell .label { font-weight: 600; color: #495057; font-size: 0.78rem; margin-bottom: 4px; }
  .scene-cell .bg { color: #6c757d; font-style: italic; }
  .scene-cell .event { margin: 2px 0; padding-left: 8px; border-left: 2px solid #adb5bd; }

  /* Video clips */
  video { max-width: 200px; border-radius: 4px; }

  /* Scene layout */
  .scene-content { display: flex; gap: 12px; align-items: flex-start; }
  .scene-text { flex: 1; }
  .scene-video { flex-shrink: 0; }
  .scene-video video { width: 200px; }

  /* Group blocks */
  .group-block { padding: 12px 0; border-bottom: 1px solid #e9ecef; }
  .group-block:last-child { border-bottom: none; }
  .group-block.group-bg { background: #e9ecef; border-radius: 6px; padding: 12px; margin: 4px 0; }
  .group-header { margin-bottom: 8px; }
  .group-clip-list { margin-top: 8px; }
  .group-clip-row { display: flex; align-items: flex-start; gap: 12px; padding: 6px 0; border-top: 1px solid #f1f3f5; }
  .group-clip-row:first-child { border-top: none; }
  .group-clip-index { width: 24px; flex-shrink: 0; font-weight: 600; color: #868e96; font-size: 0.85rem; padding-top: 4px; }
  .group-clip-video { flex-shrink: 0; }
  .group-clip-video video { width: 180px; border-radius: 4px; }
  .group-clip-desc { flex: 1; font-size: 0.83rem; color: #212529; padding-top: 4px; line-height: 1.5; }

  /* Summary highlight */
  .highlight { display: inline-block; padding: 2px 8px; border-radius: 4px; font-weight: 600; }
  .highlight-green { background: #d4edda; color: #155724; }
  .highlight-red { background: #f8d7da; color: #721c24; }
  .highlight-blue { background: #cce5ff; color: #004085; }

  /* Control table */
  .control-table { font-size: 0.82rem; }
  .control-table th { width: 160px; }

  /* Group tags */
  .group-tag { display: inline-block; padding: 1px 6px; border-radius: 3px; font-size: 0.72rem; font-weight: 600; background: #e9ecef; color: #495057; margin-left: 4px; vertical-align: middle; }
  .group-tag.verified { background: #d4edda; color: #155724; }

  /* Repeat tabs */
  .repeat-tabs { display: flex; gap: 4px; margin: 16px 0; }
  .repeat-tab { padding: 6px 16px; border: 1px solid #dee2e6; border-radius: 6px; background: #fff; cursor: pointer; font-size: 0.85rem; font-weight: 500; color: #495057; transition: all 0.15s; }
  .repeat-tab:hover { background: #e9ecef; }
  .repeat-tab.active { background: #0d6efd; color: #fff; border-color: #0d6efd; }
</style>
</head>
<body>
<div class="container">
{% block content %}{% endblock %}
</div>
</body>
</html>
