# Agent LLM (required for video analysis)
GEMINI_API_KEY=replace-me

# Optional cloud text-to-audio provider
# ELEVENLABS_API_KEY=replace-me

# Main UI and inference-server connection
V2A_INSPECT_UI_HOST=127.0.0.1
V2A_INSPECT_UI_PORT=8501
V2A_INSPECT_UI_WORK_DIR=.v2a_inspect/ui
V2A_INSPECT_UI_SERVER_URL=http://127.0.0.1:8080
V2A_INSPECT_CLIENT_SERVER_HOST=127.0.0.1
V2A_INSPECT_CLIENT_SERVER_PORT=8080
V2A_INSPECT_CLIENT_TIMEOUT=300

# LLM routing
V2A_INSPECT_LLM_SMALL_MODEL=gemini-3.1-flash-lite
V2A_INSPECT_LLM_MEDIUM_MODEL=gemini-3.5-flash
V2A_INSPECT_LLM_LARGE_MODEL=gemini-3.5-flash

# Optional UI password (blank disables authentication)
V2A_INSPECT_UI_PASSWORD=

# Inference server
V2A_SERVER_HOST=0.0.0.0
V2A_SERVER_PORT=8080
V2A_SERVER_UPLOAD_DIR=.v2a_inspect/server/uploads
V2A_SERVER_HUNYUAN_MODEL_PATH=HunyuanVideo-Foley
V2A_SERVER_HUNYUAN_MODEL_SIZE=xl
V2A_SERVER_HUNYUAN_ENABLE_OFFLOAD=false
V2A_SERVER_KOKORO_MODEL_ID=hexgrad/Kokoro-82M
V2A_SERVER_KOKORO_LANGUAGE=a
V2A_SERVER_KOKORO_VOICE=af_heart
V2A_SERVER_KOKORO_DEVICE=cpu
